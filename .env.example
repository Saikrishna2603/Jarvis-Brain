# Jarvis Brain — service configuration.
#
# Copy to .env. Contains no secrets: this is local-loopback Ollama only.
# Hosted providers need an API key, which belongs in your own .env and must
# never be committed or copied between repositories.

LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=10m
LLM_TIMEOUT_SECONDS=60

JARVIS_BRAIN_HOST=127.0.0.1
JARVIS_BRAIN_PORT=8102

# Where the other services live. Brain calls them over their public boundary,
# never by importing them.
JARVIS_MEMORY_URL=http://127.0.0.1:8103
JARVIS_SKILLS_URL=http://127.0.0.1:8105
